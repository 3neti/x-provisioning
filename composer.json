{
    "name": "3neti/x-provisioning",
    "description": "Governed provisioning requests, invitations, acceptance, and authority activation for x-change.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Lester B. Hurtado"
        }
    ],
    "autoload": {
        "psr-4": {
            "LBHurtado\\XProvisioning\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LBHurtado\\XProvisioning\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LBHurtado\\XProvisioning\\XProvisioningServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.2 || ^4.0"
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "pint": "vendor/bin/pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
